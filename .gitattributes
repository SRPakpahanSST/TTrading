# ============================================================
# KONFIGURASI GIT ATTRIBUTES
# T Trading (Tenang Trading)
# ============================================================
# File ini memastikan konsistensi line endings dan pengaturan
# file di seluruh kontributor, terlepas dari OS yang digunakan.
# Referensi: https://git-scm.com/docs/gitattributes
# ============================================================

# ============================================================
# DEFAULT: Normalisasi Line Endings
# ============================================================
# Secara default, Git akan menormalkan semua file teks ke LF
# di repository, dan mengonversinya ke CRLF saat checkout di Windows.
* text=auto eol=lf

# ============================================================
# FILE TEKS (Normalisasi ke LF)
# ============================================================
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.env       text eol=lf
*.example   text eol=lf

# ============================================================
# FILE BINER (Jangan Diubah)
# ============================================================
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.bmp       binary
*.tiff      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.rar       binary
*.7z        binary
*.mp3       binary
*.mp4       binary
*.mov       binary
*.avi       binary
*.webm      binary

# ============================================================
# FILE KHUSUS WINDOWS
# ============================================================
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ============================================================
# FILE KHUSUS LINUX/MAC
# ============================================================
*.sh        text eol=lf
Makefile    text eol=lf

# ============================================================
# FILE LOCK (Jangan Di-merge Otomatis)
# ============================================================
package-lock.json   -diff
yarn.lock           -diff
pnpm-lock.yaml      -diff
bun.lockb           -diff

# ============================================================
# FILE YANG DIABAIKAN SAAT EXPORT (git archive)
# ============================================================
.github/            export-ignore
.vscode/            export-ignore
tests/              export-ignore
coverage/           export-ignore
.editorconfig       export-ignore
.eslintignore       export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
.prettierignore     export-ignore
.prettierrc         export-ignore
CHANGELOG.md        export-ignore
CODE_OF_CONDUCT.md  export-ignore
CONTRIBUTING.md     export-ignore
ROADMAP.md          export-ignore
SECURITY.md         export-ignore
renovate.json       export-ignore

# ============================================================
# LINGUISTIK (untuk GitHub)
# ============================================================
*.js        linguist-language=JavaScript
*.jsx       linguist-language=JavaScript
*.css       linguist-language=CSS
*.html      linguist-language=HTML
*.md        linguist-language=Markdown

# Tandai file dokumentasi sebagai dokumentasi
*.md        linguist-documentation
LICENSE     linguist-documentation

# Tandai file konfigurasi sebagai konfigurasi
*.config.js linguist-language=JavaScript
*.json      linguist-language=JSON

# Kecualikan file tertentu dari statistik bahasa
package-lock.json   linguist-vendored
yarn.lock           linguist-vendored
pnpm-lock.yaml      linguist-vendored
public/**           linguist-vendored